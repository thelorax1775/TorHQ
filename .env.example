# ---------------------------------------------------------------------------
# TorHQ environment. Copy to /etc/torhq/torhq.env and lock down permissions:
#   chmod 640 /etc/torhq/torhq.env ; chown torhq:torhq /etc/torhq/torhq.env
# Only INFRASTRUCTURE config lives here. Per-service API keys/passwords are
# entered in the setup wizard and stored ENCRYPTED in the database.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Bind to loopback by default. Expose via a reverse proxy (see README).
TORHQ_HOST=127.0.0.1
TORHQ_PORT=8787

# Writable data directory (SQLite db lives here). Owned by the torhq user.
TORHQ_DATA_DIR=/srv/torhq/data

# 32+ byte master key used to encrypt stored service secrets at rest.
# Generate: openssl rand -base64 48
# Changing this AFTER services are saved makes existing secrets unreadable.
TORHQ_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48

# Colon-separated approved base directories. EVERY filesystem operation is
# validated to stay within one of these. Keep this as tight as possible.
TORHQ_APPROVED_ROOTS=/srv/torhq

# Set true ONLY when behind a trusted reverse proxy (enables X-Forwarded-*).
TORHQ_TRUST_PROXY=false

# Set true when TorHQ is served over HTTPS (marks the session cookie Secure).
TORHQ_COOKIE_SECURE=false

# Optional Prometheus metrics at /metrics (disabled by default).
TORHQ_METRICS_ENABLED=false

# Log level: fatal|error|warn|info|debug|trace
TORHQ_LOG_LEVEL=info
